{
  "name": "space-invaders",
  "version": "1.0.0",
  "description": "Carte des space invaders flashés, avec les scans du jour.",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "build": "pnpm typecheck && vite build",
    "deploy": "pnpm build && wrangler deploy"
  },
  "author": "Pierre-Louis Guhur",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/leaflet": "^1.9.22",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "private": true,
  "type": "module"
}
